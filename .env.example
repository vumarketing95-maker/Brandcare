# Sao chép file này thành ".env" khi chạy thử ở máy local (Render sẽ dùng ô "Environment" trên dashboard, không dùng file .env).

# BẮT BUỘC (cho chấm điểm nội dung) — lấy tại https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# BẮT BUỘC (cho làm mới dữ liệu Facebook trực tiếp) — lấy tại https://app.windsor.ai → Settings → API Access.
# Khác với việc kết nối Windsor.ai qua Claude đã làm trước đó — đây là 1 API key riêng của chính tài khoản windsor.ai.
WINDSOR_API_KEY=

# BẮT BUỘC — tự đặt 1 chuỗi bất kỳ (VD: 1 đoạn mật khẩu ngẫu nhiên dài) để chặn người lạ gọi thẳng API tốn phí của anh.
# Dùng CHUNG cho cả 2 tính năng (chấm điểm + làm mới dữ liệu). Đặt CÙNG 1 giá trị này vào ô "Mã bí mật backend"
# trong khối "⚙️ Cấu hình backend" ở đầu trang internal-tool.html.
APP_SECRET=

# Tuỳ chọn — model Claude dùng để chấm (có khả năng xem ảnh). Kiểm tra ID mới nhất tại console.anthropic.com nếu gặp lỗi "model not found".
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# Tuỳ chọn — cổng chạy server (Render tự set PORT, không cần sửa khi deploy trên Render).
PORT=3000
